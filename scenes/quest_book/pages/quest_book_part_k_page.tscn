text = "[b][u]Rules to Follow[/u][/b]"

[node name="Label1" type="Label" parent="Left/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1644936578) index="2" unique_id=1186512340]
custom_minimum_size = Vector2(1, 0)
