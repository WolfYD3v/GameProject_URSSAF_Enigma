[node name="Label1" type="Label" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="3" unique_id=452868149]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "This method was created by WolfY_D3v, but he doesn't believe it's his own creation.
Only the digits are affected (1–9). The rest of the code remains unchanged.
This method first lists all the digits, then performs mathematical operations.
Concrete example: 8, 1, 4, 0, 2, 5, 2, and 7 are the digits. But the encrypted digits are: 7, 6, 4, 7, 6, 3, 4, and 8. Why?

Because, let’s imagine we want to encrypt the first digit, the 8. We do: {digit to convert} - {next digit}. So here, 8 - 1.
When we get to encrypting the last digit, we do: {digit to convert} - {first digit listed}. So here, 7 - 8.
If the result is negative, as with 1 - 4, we do: subtraction_result = 9 + {subtraction_result}. So: 9 + (-3), subtraction_result = 6."
autowrap_mode = 3

