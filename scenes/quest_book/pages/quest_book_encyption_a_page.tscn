text = "[b][u]Method 3:[/u] Suffled Base64[/b]"
fit_content = true
horizontal_alignment = 1

[node name="Label3" type="Label" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="9" unique_id=331355675]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "This method only affects all characters.
It does two things:
- It encodes the secret code in Base64
- Then it scrambles the encoded characters
So it’s up to you to encode the code in Base64, then scramble the characters yourself just like the safe did.

But you don’t need to figure out how it was done—a file contains everything you need to know to shuffle the characters correctly."
autowrap_mode = 3

