[node name="TitleRichTextLabel" type="RichTextLabel" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="2" unique_id=112752959]
layout_mode = 2
bbcode_enabled = true
text = "[b][u]Method 1:[/u] Upper Lower Characters[/b]"
fit_content = true
horizontal_alignment = 1

[node name="Label1" type="Label" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="3" unique_id=85743238]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "This method was created by WolfY_D3v, but he doesn't believe it's his own creation.
This method only affects letters (a/A -> z/Z). Only the letters are encrypted; everything else remains unchanged.
It's simple: lowercase letters become uppercase, and vice versa."
autowrap_mode = 3

