[node name="TitleRichTextLabel" parent="Left/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1644936578) index="1" unique_id=1098942946]
text = "[b][u]Part 2: Encryption[/u][/b]"

[node name="Label1" type="Label" parent="Left/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1644936578) index="2" unique_id=1217518612]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "As mentioned earlier, the code is encrypted to make it as secure as possible.
You’ve already figured out the correct unencrypted secret code (I hope). But the safe only accepts the encrypted version of the code—encrypted BY the safe.
There’s just one tiny problem: You need to know the order of encryption and which methods were used.
But I’ll help you—don’t panic. The safe uses an encryption module with five pre-programmed methods to encrypt the secret code. And this module chooses five methods from the five it knows. So it chooses them all.
As for the encryption order, since it’s random, you either have to try all 25 possible combinations and hope the encrypted code works. Or I can give it to you.
That would be better, wouldn’t it (especially if you’re playing in hardcore mode—if you know what I mean). You can download a file containing this order if you want. With a little puzzle thrown in—why not? This game already artificially drags on—why stop now?
I barely have time to code a rock-paper-scissors game as it is...

The encryption methods are explained on the following pages."
autowrap_mode = 3

