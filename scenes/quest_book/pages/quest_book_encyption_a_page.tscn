[node name="Label2" type="Label" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="6" unique_id=899629838]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "This method only affects letters (a/A -> z/Z). Only the letters are encrypted; everything else remains unchanged.
There are 26 letters in the alphabet, and all the letters are simply shifted clockwise. If you shift the letter W by 10, you get the letter G."
autowrap_mode = 3

