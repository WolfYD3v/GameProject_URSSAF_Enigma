text = "[b][u]The URSSAF Safe's Secret Code: The Basics[/u][/b]"

[node name="Label1" type="Label" parent="Left/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1644936578) index="2" unique_id=546952349]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "Hello, {name of the jerk in charge of this job created to reduce unemployment in France}.
Since I don’t really want to help you out, this book will take care of that burden. It’s sort of your employee handbook, but without all those stupid rules that could have been written by a grumpy old lady in HR.

To put things in context, since 2018, the French government has decided to “punish us for our bad behavior” by freezing OUR money sitting in the safe across the hall. As if we were really that greedy!
The URSSAF then hired me to try to get OUR money back.
And now, it’s up to you to unlock the safe (they didn’t do anything to stop you… the government is as efficient as ever). You just need to find a secret code [see the next page to learn more about the secret code]. It shouldn’t be too hard for an idiot like you.
Either you succeed, or you die. It’s as simple as that.

As the official holder of this “manual,” it’s up to YOU to keep it. ONLY for yourself as much as POSSIBLE.
Management doesn’t want the key to our security to be revealed (and neither do you). It’s OUR money, damn it!!!!!"
autowrap_mode = 3

[node name="TitleRichTextLabel" type="RichTextLabel" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="2" unique_id=288541257]
