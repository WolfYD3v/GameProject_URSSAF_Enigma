[node name="Label1" type="Label" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="3" unique_id=152059399]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "Some retirees (some of whom are better people than you) have reported to Management that strange things have been happening around them, like objects appearing or disappearing in the room, or the book unlocking more and more pages.
That’s totally normal! Even though I can’t explain why (as the author of the manual), it’s very normal.
It even rewards you for unlocking pages with incredible rewards! Isn’t that awesome? :)

As a good employee, you must accept its Holy Grace.
Maybe it will help you on your mission—who knows?"
autowrap_mode = 3
