text = "[b][u]URSSAF Safe Code: The Basics[/u][/b]"

[node name="Label1" type="Label" parent="Left/Nodes" parent_id_path=PackedInt32Array(1644936578) index="2" unique_id=546952349]
custom_minimum_size = Vector2(1, 0)
