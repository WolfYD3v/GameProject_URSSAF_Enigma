[node name="Label1" type="Label" parent="Right/MarginContainer/Nodes" parent_id_path=PackedInt32Array(1257509253) index="2" unique_id=1556710570]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "In the second phase, the safe isn't sure if the secret code is secure enough. So it will encrypt the whole thing using a random sequence of five methods (one after another).

Why?
While the safe will accept the encrypted secret code as a valid input, the book only knows the unencrypted version.
You’ll have to encrypt the code you’ve found yourself in the correct encryption order.

I told you it was a thankless job."
autowrap_mode = 3
